{
  "name": "gemini-voice-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Premium real-time AI voice chat application using Gemini 2.5 Flash",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "npm install",
    "build": "npm run build --workspace=frontend",
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "start": "npm start --workspace=backend",
    "start:backend": "npm start --workspace=backend",
    "start:frontend": "npm run dev --workspace=frontend"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
